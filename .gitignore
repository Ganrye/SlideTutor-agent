# Raster exports and extracted figures. App assets are explicitly allowed below.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tif
*.tiff

# Keep deliberate frontend demo/static assets visible to Git.
!apps/web/public/
!apps/web/public/**
!apps/web/src/assets/
!apps/web/src/assets/**
